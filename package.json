{
  "name": "powerbicraft",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "PowerBICraft - a local, self-contained BI workbench rebuilt from Power BI Desktop's report model",
  "author": "Lingesh Kumar M",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "api": "tsx server/main.ts",
    "serve": "tsx server/main.ts",
    "build": "tsc --noEmit && tsc -p tsconfig.server.json && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "check:server": "tsc -p tsconfig.server.json",
    "smoke:api": "tsx tests/smoke-server.ts"
  },
  "dependencies": {
    "fflate": "^0.8.2",
    "firebase": "^13.1.0",
    "idb": "^8.0.4",
    "jose": "^6.2.13",
    "nodemailer": "^6.10.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^6.4.24",
    "fake-indexeddb": "^6.2.6",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.9"
  }
}
