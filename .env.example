# PowerBICraft service configuration. Copy to .env and fill only what you use.
# Guest authoring, IndexedDB storage and local project files need no values.

# ---------------------------------------------------------------- service
PORT=5180
HOST=127.0.0.1
# PBC_DB=data/powerbicraft.db
# PBC_DATA=data
# PBC_DIST=dist
# Public base used in share links, Google OAuth redirects and mail.
# In dev with Vite on 5178, set this to http://localhost:5178.
# PBC_PUBLIC_URL=http://localhost:5178

# Key material for sealed share links and Google Drive refresh tokens.
# Generate once, e.g. openssl rand -base64 48, and keep it out of git.
# PBC_SECRET=

# PBC_SCHEDULER=1
# PBC_TICK_MS=30000
# PBC_SCHEDULE_LEASE=300000
# PBC_JOB_ATTEMPTS=3
# PBC_RETRY_DELAY=400
# PBC_BODY_LIMIT=67108864
# PBC_INSTANCE_ID=pbc-local
# PBC_TRUST_PROXY=0

# Refresh safety. Leave both off unless you are running isolated tests.
# PBC_ALLOW_PRIVATE_SOURCES=0
# PBC_ALLOW_ABSOLUTE_SOURCES=0

# ------------------------------------------------------------ email / snapshots
# PBC_SMTP_URL=smtp://user:pass@smtp.example.com:587
# PBC_MAIL_FROM=PowerBICraft <no-reply@powerbicraft.local>
# PBC_SNAPSHOT=1
# PBC_SNAPSHOT_WAIT=8000
# PBC_BROWSER=C:\Program Files (x86)\Microsoft\Edge\Application\msedge.exe

# --------------------------------------------------------------- Firebase Auth
# Create a Web app in the Firebase console and enable Email/Password.
# The web API key is public by design; the server verifies ID tokens with JWKS.
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_APP_ID=
FIREBASE_MESSAGING_SENDER_ID=

# ------------------------------------------------------------------ Google Drive
# Google Cloud console -> OAuth consent screen -> Web client.
# Authorized redirect URI must be PUBLIC_URL/api/google/callback.
# Scope requested: https://www.googleapis.com/auth/drive.file
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:5178/api/google/callback

# ------------------------------------------------------------------------- Groq
# Server-only. Never expose this key in VITE_* variables.
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# GROQ_TIMEOUT_MS=45000
# GROQ_GUEST_PER_HOUR=3
# GROQ_GUEST_PER_DAY=10
# GROQ_USER_PER_HOUR=20
# GROQ_USER_PER_DAY=100
# GROQ_MAX_BODY=49152

# ------------------------------------------------------------------- Vercel cron
# Vercel sends this as "Authorization: Bearer <CRON_SECRET>".
# CRON_SECRET=
